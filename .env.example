# Application
APP_NAME=FastAPI Clean Architecture
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/app_db
DB_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Z-AI Configuration (Required for food image analysis)
ZAI_API_KEY=your-zai-api-key-here
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (Optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Apple OAuth (Optional)
# APPLE_CLIENT_ID=your-apple-client-id
# APPLE_TEAM_ID=your-apple-team-id
# APPLE_KEY_ID=your-apple-key-id
# APPLE_PRIVATE_KEY=your-apple-private-key
# APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/apple/callback
